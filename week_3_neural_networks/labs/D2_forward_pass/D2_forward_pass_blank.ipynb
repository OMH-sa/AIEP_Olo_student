    "LECTURE = {\n",
    "    \"W1\": torch.tensor([[0.5, -0.5],\n",
    "                        [1.0,  0.5]]),\n",
    "    \"b1\": torch.tensor([0.0, 0.5]),\n",
    "    \"W2\": torch.tensor([[1.0], [-1.0]]),\n",
    "    \"b2\": torch.tensor([0.0]),\n",
    "}\n",
    "\n",
